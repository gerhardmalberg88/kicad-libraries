ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Original Harwin_Datamate_M80-5T10442MC model | SPDX-License-Identifier: CERN-OHL-P-2.0 | Copyright 2026 Gerhard Malberg | Source: https://www.harwin.com/products/M80-5T10442MC | Harwin Datamate M80 2.00mm pitch. Pitch, 2.00 row spacing, contact positions, body envelope, above-board height and 3.30 PC tails were measured from the manufacturer reference solid for the part (dimensional facts only; this model shares no geometry with it). The 0.90 contact hole comes from the PCB layout view on Harwin drawing M80-511, measured against the known 2.00 pitch. Catalogue ratings: 3.3A per contact, 800V working, 25mOhm max, 500 mating cycles, -55 to +125C, 100G shock; M80-5T10442MC has 4 contacts in 2 row(s), a 14.00mm housing and 101-Lok retainer fixings at x +/-4.50mm which sit above the seating plane'),'2;1');
FILE_NAME('Harwin_Datamate_M80-5T10442MC.step','2026-07-11T00:00:00',('Gerhard Malberg'),('Gerhard Malberg'),'FreeCAD 1.1.1','FreeCAD 1.1.1 / generate_original_freecad_models.py','CERN-OHL-P-2.0');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
