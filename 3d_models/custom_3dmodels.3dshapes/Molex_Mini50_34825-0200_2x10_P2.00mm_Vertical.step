HEADER;
FILE_DESCRIPTION(('Original Molex_Mini50_34825-0200_2x10_P2.00mm_Vertical model | SPDX-License-Identifier: CERN-OHL-P-2.0 | Copyright 2026 Gerhard Malberg | Source: https://www.molex.com/en-us/products/part-detail/348250200 | Molex sales drawing SD-348250200 (MINI50 12-24CKT VERT HDR): 2.00 pitch, 1.00 contact holes, 0.40 x 0.50 blades, DIM E post holes 2.15 press fit / 2.55 drop in, body width 12.17 and 15.60 above the PCB. Row spacing 2.20 and the aligned (not staggered) rows were measured from the drawn hole centres in the PCB layout views and cross-checked against the sheets 4.75 and 2.55 transverse callouts, whose difference is that row spacing. Shroud depth 6.44 carried over from SD-34792-001, the mating interface being common to the series; body length 28.40 and post spacing 27.70 for the 20-way'),'2;1');
FILE_NAME('Molex_Mini50_34825-0200_2x10_P2.00mm_Vertical.step','2026-07-11T00:00:00',('Gerhard Malberg'),('Gerhard Malberg'),'FreeCAD 1.1.1','FreeCAD 1.1.1 / generate_original_freecad_models.py','CERN-OHL-P-2.0');
